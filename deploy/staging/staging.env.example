# Staging Environment Variable Template for TrainWatch
APP_ENV=staging
LOG_LEVEL=INFO
TRAIN_API_BASE_URL=https://dream-destiny.cloud.run
FIREBASE_PROJECT_ID=trainwatch-staging-placeholder
GOOGLE_CLOUD_PROJECT=trainwatch-staging-placeholder
GOOGLE_CLOUD_REGION=asia-south1
FIRESTORE_DATABASE_ID=(default)
CLOUD_TASKS_QUEUE=trainwatch-reminder-jobs-staging
CLOUD_TASKS_LOCATION=asia-south1
RATE_LIMIT_PER_MINUTE=120
REQUEST_TIMEOUT_SECONDS=15.0
ENABLE_RATE_LIMITER=true
